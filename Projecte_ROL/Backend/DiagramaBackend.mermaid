classDiagram
    class FlaskApp {
        +run()
    }

    class AuthController {
        +register()
        +login()
    }

    class CharacterController {
        +create_character()
        +get_characters()
        +get_character_detail()
    }

    class GameController {
        +create_game()
        +get_my_games()
        +get_available_games()
        +join_game()
    }

    class User {
        +create()
        +get_by_username()
        +get_by_id()
        --
        -id: int
        -username: str
        -password: str
        -email: str
        -role: str
    }

    class Character {
        +create()
        +get_by_user()
        +get_detail()
        --
        -id: int
        -user_id: int
        -name: str
        -race: str
        -class: str
        -level: int
        -experience: int
        -strength: int
        -dexterity: int
        -constitution: int
        -intelligence: int
        -wisdom: int
        -charisma: int
        -hit_points: int
        -max_hit_points: int
        -gold: int
        -background: str
    }

    class Game {
        +create()
        +get_by_master()
        +get_available()
        +join()
        --
        -id: int
        -master_id: int
        -name: str
        -description: str
        -status: str
        -created_at: datetime
    }

    class Database {
        +get_db()
    }

    class JWTManager {
        +create_access_token()
        +create_refresh_token()
        +jwt_required()
        +get_jwt_identity()
    }

    FlaskApp --> AuthController
    FlaskApp --> CharacterController
    FlaskApp --> GameController

    AuthController --> User : utiliza
    AuthController --> JWTManager : utiliza

    CharacterController --> Character : utiliza
    CharacterController --> JWTManager : requiere autenticación

    GameController --> Game : utiliza
    GameController --> JWTManager : requiere autenticación

    User --> Database : usa
    Character --> Database : usa
    Game --> Database : usa

